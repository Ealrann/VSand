#version 450

#define WORKGROUP_SIZE_X 64

layout (local_size_x = WORKGROUP_SIZE_X, local_size_y = 1, local_size_z = 1) in;

layout (constant_id = 0) const int MATERIAL_COUNT = 1;
layout (constant_id = 1) const int WIDTH = 1;
layout (constant_id = 2) const int HEIGHT = 1;

const int SWIZZLED_WIDTH = WIDTH / 2;
const int SWIZZLED_HEIGHT = HEIGHT / 2;

#include "mass_utils.glsl"

const uint MATERIAL_FLAG_PRESSURE_LIQUID = 1u;
const uint HEAD_GROUNDED_BIT = 0x80000000u;

struct Entry
{
	int isStatic;
	int density;
	int runoff;
	int flags;
	vec4 color;
};

layout (push_constant) uniform PushConstants
{
	float random;
	uint boardToWrite;
} pushConstants;

layout(binding = 0) uniform SConfiguration
{
	Entry materials[MATERIAL_COUNT];
} configuration;

layout(binding = 3) buffer readonly SBoard1
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT];
} board1;

layout(binding = 4) buffer readonly SBoard2
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT];
} board2;

layout(binding = 5) buffer readonly SMass1
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT * 2];
} mass1;

layout(binding = 6) buffer readonly SMass2
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT * 2];
} mass2;

layout(binding = 7) buffer SHead
{
	uint data[];
} head;

uint readPackedBoard(ivec2 swizzledLoc);
uint readMaterialGlobal(ivec2 loc);
uint readPackedMassWord(int index);
uint readMassGlobal(ivec2 loc);
bool isPressureLiquid(uint materialId);
bool isSupportedBy(ivec2 belowLoc, uint belowMat, uint currentMat, uint belowIndex);

void main()
{
	const int x = int(gl_GlobalInvocationID.x);
	if (x >= WIDTH) return;

	uint groundedMat = 0u;
	uint groundedBit = 0u;
	for (int y = HEIGHT - 1; y >= 0; --y)
	{
		const ivec2 loc = ivec2(x, y);
		const uint mat = readMaterialGlobal(loc);
		const uint mass = mat != 0u && isPressureLiquid(mat) ? readMassGlobal(loc) : 0u;
		const int index = x + y * WIDTH;

		if (mass == 0u)
		{
			groundedMat = 0u;
			groundedBit = 0u;
			head.data[index] = 0u;
			continue;
		}

		if (mat != groundedMat)
		{
			groundedMat = mat;
			groundedBit = 0u;
			if (y + 1 < HEIGHT)
			{
				const ivec2 belowLoc = loc + ivec2(0, 1);
				const uint belowMat = readMaterialGlobal(belowLoc);
				const int belowIndex = x + (y + 1) * WIDTH;
				if (isSupportedBy(belowLoc, belowMat, mat, belowIndex))
				{
					groundedBit = HEAD_GROUNDED_BIT;
				}
			}
		}

		head.data[index] = groundedBit;
	}

	uint sum = 0u;
	uint currentMat = 0u;

	for (int y = 0; y < HEIGHT; ++y)
	{
		const ivec2 loc = ivec2(x, y);
		const uint mat = readMaterialGlobal(loc);
		const uint mass = mat != 0u && isPressureLiquid(mat) ? readMassGlobal(loc) : 0u;

		const int index = x + y * WIDTH;

		if (mass == 0u)
		{
			sum = 0u;
			currentMat = 0u;
			head.data[index] = 0u;
			continue;
		}

		if (mat != currentMat)
		{
			currentMat = mat;
			sum = 0u;
		}

		sum += mass;
		head.data[index] = (head.data[index] & HEAD_GROUNDED_BIT) | sum;
	}
}

bool isSupportedBy(ivec2 belowLoc, uint belowMat, uint currentMat, uint belowIndex)
{
	if (belowMat == 0u) return false;

	const int belowDensity = configuration.materials[belowMat].density;
	const int currentDensity = configuration.materials[currentMat].density;
	const bool denseEnough = configuration.materials[belowMat].isStatic != 0 || belowDensity >= currentDensity;
	if (denseEnough == false) return false;

	if (isPressureLiquid(belowMat))
	{
		return (head.data[belowIndex] & HEAD_GROUNDED_BIT) != 0u;
	}
	else
	{
		return true;
	}
}

bool isPressureLiquid(uint materialId)
{
	return (uint(configuration.materials[materialId].flags) & MATERIAL_FLAG_PRESSURE_LIQUID) != 0u;
}

uint readPackedBoard(ivec2 swizzledLoc)
{
	const int index = swizzledLoc.x * SWIZZLED_HEIGHT + swizzledLoc.y;
	return pushConstants.boardToWrite == 0 ? board2.data[index] : board1.data[index];
}

uint readMaterialGlobal(ivec2 loc)
{
	ivec2 swizzled = loc >> 1;
	uint offset = ((loc.x & 1) | ((loc.y & 1) << 1)) << 3;
	uint value = readPackedBoard(swizzled);
	return (value >> offset) & 0xFFu;
}

uint readPackedMassWord(int index)
{
	return pushConstants.boardToWrite == 0 ? mass2.data[index] : mass1.data[index];
}

uint readMassGlobal(ivec2 loc)
{
	const uvec2 ms = massIndexShift(loc);
	const uint word = readPackedMassWord(int(ms.x));
	return packedU16Read(word, ms.y);
}
