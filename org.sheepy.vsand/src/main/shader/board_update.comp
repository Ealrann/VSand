#version 450

#include "rand_utils.glsl"

#define UP    0
#define DOWN  1
#define RIGHT 2
#define LEFT  3

#define TO_UP    1
#define TO_DOWN  2
#define TO_RIGHT 4
#define TO_LEFT  8

#define TARGET_VALUE_POSITION 16u
#define INITIAL_VALUE_POSITION 24u

#define EFFECTIVE_SIZE 16
#define WORKGROUP_SIZE 20

layout (local_size_x = WORKGROUP_SIZE, local_size_y = WORKGROUP_SIZE, local_size_z = 1) in;

layout (constant_id = 0) const int MATERIAL_COUNT = 1;
layout (constant_id = 1) const int WIDTH = 1;
layout (constant_id = 2) const int HEIGHT = 1;

const int CHUNK_WIDTH = WIDTH / EFFECTIVE_SIZE;
const int CHUNK_HEIGHT = HEIGHT / EFFECTIVE_SIZE;

const int TRANSFORM_ARRAY_COUNT = (MATERIAL_COUNT * MATERIAL_COUNT + 3) / 4;
const int WORKGROUP_AREA = WORKGROUP_SIZE * WORKGROUP_SIZE;

const uint STATIC_TRANSFO_FLAG = 1 << 30;
const uint MOVED_TAG = 1 << 4;
const uint TARGET_VALUE_MASK = 255u << TARGET_VALUE_POSITION;
const uint DECISION_DIR_MASK = 15u;
const uint DECISION_CLEAR_INITIAL_MASK = 0x00FFFFFFu;
const uint DECISION_KEEP_RANDOM_AND_INITIAL_MASK = 0xFF00FF00u;

const int SWIZZLED_WIDTH = WIDTH / 2;
const int SWIZZLED_HEIGHT = HEIGHT / 2;

#include "mass_utils.glsl"

struct Entry
{
	int isStatic;
	int density;
	int runoff;
	int flags;
	vec4 color;
};

// Random number, change each frame.
layout (push_constant) uniform PushConstants {
	float random;
	uint boardToWrite;
} pushConstants;

// The definition of materials.
layout(binding = 0) uniform SConfiguration
{
	Entry materials[MATERIAL_COUNT];
} configuration;

// The description of the transformations.
// Each cell contains :
// 1 bit for the sign
// 1 bit for isStatic (if the transformation should occur only if the material doesn't move.
// 14 bits for the probability (not all used, probability is only an integer from 0 to 1000).
// 8 bits for the propagated distance.
// 8 bits for the target value.
layout(binding = 1) uniform STransformation
{
	// float[] is horrible in uniform buffers (std140), so we use uvec4[]
	uvec4 data[TRANSFORM_ARRAY_COUNT];
}transformations;

// The chunk state board.
layout(binding = 2) buffer SChunks
{
	int data[CHUNK_WIDTH * CHUNK_HEIGHT];
}chunks;

// The game board, with all the values.
layout(binding = 3) buffer SBoard1
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT];
}board1;

// The next game board, with all the values.
layout(binding = 4) buffer SBoard2
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT];
}board2;

layout(binding = 5) buffer SMass1
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT * 2];
}mass1;
layout(binding = 6) buffer SMass2
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT * 2];
}mass2;

// DecisionBoard store necessary informations around movement.
// Each 32 bit value (one per cell) stores:
// 8 bits for the initial value
// 8 bits for the swapped value
// 8 unused bits with a random value.
// 3 unused bits.
// 1 bit, true if the cell is swapped.
// 4 bits for the direction we intend to swap.
shared uint cellDecision[WORKGROUP_SIZE][WORKGROUP_SIZE];
shared uint cellMaterial[WORKGROUP_SIZE][WORKGROUP_SIZE];
shared uint cellMass[WORKGROUP_SIZE][WORKGROUP_SIZE];
shared uint cellMassSrc[WORKGROUP_SIZE][WORKGROUP_SIZE];
shared uint pressureShiftClaim[WORKGROUP_SIZE][WORKGROUP_SIZE];
shared bool chunkActive;
shared bvec4 chunkNeighborActive;
shared uint updatedFlag;
shared Entry materials[MATERIAL_COUNT];

const uint MATERIAL_FLAG_PRESSURE_LIQUID = 1u;
const int CHUNK_FLAG_SIM_ACTIVE = 1;
const int CHUNK_FLAG_RENDER_DIRTY = 2;
const uvec4 unswizzleVec = uvec4(0xFF, 0xFF00, 0xFF0000, 0xFF000000);
const uvec4 unswizzleOffset = uvec4(0, 8, 16, 24);
const ivec4 farBorderLoc   = ivec4(0, 0, WORKGROUP_SIZE - 1, WORKGROUP_SIZE - 1);
const ivec4 closeBorderLoc = ivec4(1, 1, WORKGROUP_SIZE - 2, WORKGROUP_SIZE - 2);
const ivec4 innerBorderLoc = ivec4(2, 2, WORKGROUP_SIZE - 3, WORKGROUP_SIZE - 3);

// Bounded pressure-assist controls. These helpers are local, conservative
// visible-particle shifts; normal falling/swapping remains the primary movement.
const int PRESSURE_REAR_LOOKBACK = 16;
const int PRESSURE_COLUMN_LOOKBACK = 24;
const int PRESSURE_SETTLED_SUPPORT_LOOKBACK = 48;
const int PRESSURE_PIPE_WALL_LOOKUP = 10;
const int PRESSURE_ROW_SHIFT_MAX = 8;
const int PRESSURE_STACK_LOOKUP = 6;
const int PRESSURE_SURFACE_LOOKUP = 8;
const int PRESSURE_PIPE_WALL_VERTICAL_LOOKUP = 2;
const int PRESSURE_COLUMN_LIFT_MAX = 15;
const int PRESSURE_COLUMN_LIFT_BOTTOM_MAX_Y = WORKGROUP_SIZE - 3;
const int PRESSURE_COLUMN_LIFT_SCAN_MAX_Y = WORKGROUP_SIZE - 2;
const int PRESSURE_LOCAL_SAFE_MIN = 2;
const int PRESSURE_LOCAL_SAFE_MAX_EXCLUSIVE = WORKGROUP_SIZE - 3;
const int PRESSURE_ROW_SCAN_MIN_X = PRESSURE_LOCAL_SAFE_MIN;
const int PRESSURE_ROW_SCAN_MAX_EXCLUSIVE_X = WORKGROUP_SIZE - PRESSURE_LOCAL_SAFE_MIN;
const int PRESSURE_ROW_FRONT_MIN_X = 1;
const int PRESSURE_ROW_FRONT_MAX_EXCLUSIVE_X = WORKGROUP_SIZE - 1;
const int PRESSURE_FALLBACK_INTERIOR_MIN = PRESSURE_LOCAL_SAFE_MIN + 1;
const int PRESSURE_FALLBACK_SOURCE_LAG = 2;
const uint PRESSURE_SETTLED_OVERFULL_MASS = M_EPS;
const uint PRESSURE_LIFT_MASS_DELTA = M_EPS << 1;
const uint PRESSURE_LIFT_OVERFULL_MASS = M_EPS;
const uint PRESSURE_COLUMN_MASS_DELTA = M_EPS << 1;
const uint PRESSURE_COLUMN_OVERFULL_MASS = M_EPS << 2;
const uint PRESSURE_ROW_MASS_DELTA = M_EPS << 4;
const uint PRESSURE_ROW_OVERFULL_MASS = M_EPS << 1;
const uint PRESSURE_REAR_MASS_DELTA_STEP = M_EPS;
const int PRESSURE_LEVEL_SCORE_BIAS = int(M_EPS << 4);
const int PRESSURE_LEVEL_SCORE_TIE = int(M_EPS);
const int PRESSURE_SOURCE_SCORE_DRAINABLE_STACK = 4096;
const int PRESSURE_SOURCE_SCORE_DISTANCE_STEP = 64;
const int PRESSURE_SOURCE_SCORE_STACK_HEIGHT_STEP = 8;
const int PRESSURE_SOURCE_SCORE_MASS_GRADIENT = 64;
const int PRESSURE_SOURCE_SCORE_REAR_PUSH = 32;


bool chooseTo(ivec2 loc, ivec2 localLoc);
bool acceptFrom(ivec2 loc, ivec2 localLoc);
bool swap(ivec2 loc, ivec2 localLoc);
bool tryPressureColumnLift(ivec2 loc, ivec2 localLoc);
bool tryPressureRowShift(ivec2 loc, ivec2 localLoc);
bool tryPressureRowShiftToward(ivec2 loc, ivec2 localLoc, int dir);
int pressureColumnLiftBottomY(ivec2 loc, ivec2 localLoc, uint liquidValue, int liquidDensity);
bool hasPressureForColumnLift(ivec2 loc, ivec2 localLoc, uint liquidValue, int liquidDensity, int bottomY);
bool lockPressureColumnLift(int x, int topY, int bottomY, uint claim);
void releasePressureColumnLift(int x, int topY, int bottomY, uint claim);
bool lockPressureDrain(int y, int fromX, int toX, int stackX, int stackTopY, uint claim);
void releasePressureDrain(int y, int fromX, int toX, int stackX, int stackTopY, uint claim);
bool claimPressureCell(ivec2 claimLocal, bool required, uint claim);
void releasePressureCell(ivec2 claimLocal, bool required, uint claim);
void drainPressureStackIntoSource(ivec2 sourceLocal, int topY, uint targetValue, uint targetMass, uint liquidValue);
bool isHorizontalPressureOutlet(ivec2 loc, ivec2 localLoc, uint liquidValue, int liquidDensity);
bool isVerticalPressureOutlet(ivec2 loc, ivec2 localLoc, uint liquidValue, int liquidDensity);
bool isBulkInterior(ivec2 loc, ivec2 localLoc, uint liquidValue);
bool isSupportedSettledPressureLiquid(ivec2 loc, ivec2 localLoc, uint liquidValue, int liquidDensity);
bool hasReachablePressureSupportBelow(ivec2 loc, ivec2 localLoc, uint liquidValue, int liquidDensity);
bool hasOpenSurfaceAbove(ivec2 loc, ivec2 localLoc, uint liquidValue);
int stackHeightAbove(ivec2 loc, ivec2 localLoc, uint liquidValue);
int pressureStackTopY(ivec2 sourceLocal, uint liquidValue);
bool canDrainPressureStack(ivec2 sourceLocal, uint liquidValue);
bool canLeavePressureSourceHole(ivec2 loc, ivec2 localLoc, int dir, uint liquidValue);
bool canUseFallbackPressureSource(ivec2 loc, ivec2 localLoc, int dir, uint liquidValue);
bool transformation(ivec2 loc, ivec2 localLoc, bool moved);
int checkFree(ivec2 loc, in ivec2 localLoc, int runoff, int dir, int srcDensity);
bool isInsideLocal(ivec2 localLoc);
bool isOutsideBoard(ivec2 loc);
uint readPackedBoard(ivec2 swizzledLoc);
void writePackedBoard(ivec2 swizzledLoc, uint value);
	void loadCellMaterial2x2FromGlobal(ivec2 loc, ivec2 localLoc);
	void loadCellMass2x2FromGlobal(ivec2 loc, ivec2 localLoc);
	uint readMaterial(ivec2 loc, ivec2 localLoc);
	uint readMaterialGlobal(ivec2 loc);
	uint readMassGlobal(ivec2 loc);
	uint readPackedMassWord(ivec2 swizzledLoc, int row);
	void writePackedMassWord(int index, uint value);
	void markUpdated();
	bool isUpdated();
uint decisionInitialValue(uint decisionValue);
uint decisionTargetValue(uint decisionValue);
uint decisionDirection(uint decisionValue);
int chunkIndex(ivec2 chunkLoc);
bool isChunkActive(ivec2 chunkLoc);
void initCellMaterial(ivec2 loc, ivec2 localLoc, bool invalid, bool evenCell);
void initChunkActivity();
void loadMaterialsShared();
void writeBackBoard(ivec2 loc, ivec2 localLoc, bool invalid, bool evenCell, bool farBorder, bool closeBorder);
void updateChunkState();
bool isPressureLiquid(uint materialId);
bool applyTransform(ivec2 localLoc, uint currentValue, uint targetValue);
bool isOverfullPressureMass(uint mass, uint minOverfull);
bool hasPressureMassSignal(uint sourceMass, uint targetMass, uint minDelta, uint minOverfull);
bool hasStrongPressureMassSignal(uint sourceMass, uint targetMass, uint minDelta, uint minOverfull);
bool hasRearMassPressure(uint rearMass, uint currentMass, int offset);
bool hasRearPressure(ivec2 loc, ivec2 localLoc, int dir, uint currentValue, uint currentMass, int density);
bool hasColumnPressureBelow(ivec2 loc, ivec2 localLoc, uint currentValue, uint currentMass);
bool isInPressurePipe(ivec2 loc, ivec2 localLoc, uint currentValue, int density);
bool hasPipeWall(ivec2 loc, ivec2 localLoc, int dir, uint currentValue, int density);
bool isPressureBarrier(uint materialId, int density);
bool hasVerticalPipeWallAt(ivec2 wallLoc, ivec2 wallLocal, int density);

/**
 * Here, we will choose one favourite destination.
 */
void main()
{
	ivec2 loc = ivec2(gl_GlobalInvocationID.xy) - 2 - (4 * ivec2(gl_WorkGroupID.xy));
	ivec2 localLoc = ivec2(gl_LocalInvocationID.xy);

	bool evenCell = (loc.x & 1) == 0 && (loc.y & 1) == 0;
	bool invalid = isOutsideBoard(loc);
	ivec4 dualLoc = ivec4(localLoc.xyxy);

	bvec4 farBorderVec = equal(dualLoc, farBorderLoc);
	bool farBorder = any(farBorderVec);

	bvec4 closeBorderVec = equal(dualLoc, closeBorderLoc);
	bool closeBorder = any(closeBorderVec);

	bvec4 innerBorderVec = equal(dualLoc, innerBorderLoc);

	initCellMaterial(loc, localLoc, invalid, evenCell);
	initChunkActivity();
	loadMaterialsShared();


	barrier();


	uint currentValue = cellMaterial[localLoc.x][localLoc.y];
	// Erase Tag,
	// Erase previous value
	// and Store the current value to the decision buffer.
	cellDecision[localLoc.x][localLoc.y] = currentValue << INITIAL_VALUE_POSITION;
	pressureShiftClaim[localLoc.x][localLoc.y] = 0u;

	bool dynamicCell = materials[currentValue].isStatic == 0;
	bool borderActive = (((innerBorderVec.x || closeBorderVec.x) && chunkNeighborActive.x)
					  || ((innerBorderVec.y || closeBorderVec.y) && chunkNeighborActive.y)
					  || ((innerBorderVec.z || closeBorderVec.z) && chunkNeighborActive.z)
					  || ((innerBorderVec.w || closeBorderVec.w) && chunkNeighborActive.w));

	bool activeCell = !invalid && dynamicCell && (chunkActive || borderActive);

	bool choosedTo = false;
	if (activeCell)
	{
		choosedTo = chooseTo(loc, localLoc);
	}


	barrier();


	bool acceptedFrom = false;
	if(!choosedTo && !farBorder && activeCell)
	{
		acceptedFrom = acceptFrom(loc, localLoc);
	}


	barrier();


	bool swapped = false;
	if((choosedTo || acceptedFrom) && !closeBorder && !farBorder)
	{
		markUpdated();
		swapped = swap(loc, localLoc);
	}


	barrier();

	bool lifted = false;
	if(activeCell && !closeBorder && !farBorder)
	{
		lifted = tryPressureColumnLift(loc, localLoc);
		if (lifted)
		{
			markUpdated();
		}
	}


	barrier();

	pressureShiftClaim[localLoc.x][localLoc.y] = 0u;


	barrier();

	bool displaced = false;
	if(activeCell && !closeBorder && !farBorder)
	{
		displaced = tryPressureRowShift(loc, localLoc);
		if (displaced)
		{
			markUpdated();
		}
	}


	barrier();

	pressureShiftClaim[localLoc.x][localLoc.y] = 0u;


	barrier();

	if(!closeBorder && !farBorder)
	{
		if(transformation(loc, localLoc, swapped || lifted || displaced))
		{
			markUpdated();
		}
	}


		barrier();

		writeBackBoard(loc, localLoc, invalid, evenCell, farBorder, closeBorder);
		updateChunkState();
	}

uint decisionInitialValue(uint decisionValue)
{
	return decisionValue >> INITIAL_VALUE_POSITION;
}

uint decisionTargetValue(uint decisionValue)
{
	return (decisionValue & TARGET_VALUE_MASK) >> TARGET_VALUE_POSITION;
}

uint decisionDirection(uint decisionValue)
{
	return decisionValue & DECISION_DIR_MASK;
}

bool isPressureLiquid(uint materialId)
{
	return (uint(materials[materialId].flags) & MATERIAL_FLAG_PRESSURE_LIQUID) != 0u;
}

int chunkIndex(ivec2 chunkLoc)
{
	return chunkLoc.x * CHUNK_HEIGHT + chunkLoc.y;
}

bool isChunkActive(ivec2 chunkLoc)
{
	return (chunks.data[chunkIndex(chunkLoc)] & 1) != 0;
}

void initCellMaterial(ivec2 loc, ivec2 localLoc, bool invalid, bool evenCell)
{
	if(invalid)
	{
		cellMaterial[localLoc.x][localLoc.y] = 0;
		cellMass[localLoc.x][localLoc.y] = 0u;
		cellMassSrc[localLoc.x][localLoc.y] = 0u;
	}
	else if (evenCell)
	{
		loadCellMaterial2x2FromGlobal(loc, localLoc);
		loadCellMass2x2FromGlobal(loc, localLoc);
	}
}

void initChunkActivity()
{
	if(gl_LocalInvocationIndex != 0)
	{
		return;
	}

	updatedFlag = 0u;
	ivec2 chunkLoc = ivec2(gl_WorkGroupID.xy);
	chunkActive = isChunkActive(chunkLoc);
	if(gl_WorkGroupID.x > 0)
		chunkNeighborActive.x = isChunkActive(chunkLoc + ivec2(-1, 0));
	else
		chunkNeighborActive.x = false;
	if(gl_WorkGroupID.y > 0)
		chunkNeighborActive.y = isChunkActive(chunkLoc + ivec2(0, -1));
	else
		chunkNeighborActive.y = false;
	if(gl_WorkGroupID.x < CHUNK_WIDTH - 1)
		chunkNeighborActive.z = isChunkActive(chunkLoc + ivec2(1, 0));
	else
		chunkNeighborActive.z = false;
	if(gl_WorkGroupID.y < CHUNK_HEIGHT - 1)
		chunkNeighborActive.w = isChunkActive(chunkLoc + ivec2(0, 1));
	else
		chunkNeighborActive.w = false;
}

void loadMaterialsShared()
{
	if(gl_LocalInvocationIndex < MATERIAL_COUNT)
	{
		materials[gl_LocalInvocationIndex] = configuration.materials[gl_LocalInvocationIndex];
	}
}

void writeBackBoard(ivec2 loc, ivec2 localLoc, bool invalid, bool evenCell, bool farBorder, bool closeBorder)
{
	if(evenCell && !invalid && (isUpdated() || chunkActive) && !farBorder && !closeBorder)
	{
		ivec2 swizzledLoc = loc >> 1;

		uint value = cellMaterial[localLoc.x][localLoc.y]
				  | (cellMaterial[localLoc.x + 1][localLoc.y] << 8)
				  | (cellMaterial[localLoc.x][localLoc.y + 1] << 16)
				  | (cellMaterial[localLoc.x + 1][localLoc.y + 1] << 24);

			writePackedBoard(swizzledLoc, value);

			const int baseIndex = (swizzledLoc.x * SWIZZLED_HEIGHT + swizzledLoc.y) * 2;
			const uint mass00 = isPressureLiquid(cellMaterial[localLoc.x][localLoc.y]) ? cellMass[localLoc.x][localLoc.y] : 0u;
			const uint mass10 = isPressureLiquid(cellMaterial[localLoc.x + 1][localLoc.y]) ? cellMass[localLoc.x + 1][localLoc.y] : 0u;
			const uint mass01 = isPressureLiquid(cellMaterial[localLoc.x][localLoc.y + 1]) ? cellMass[localLoc.x][localLoc.y + 1] : 0u;
			const uint mass11 = isPressureLiquid(cellMaterial[localLoc.x + 1][localLoc.y + 1]) ? cellMass[localLoc.x + 1][localLoc.y + 1] : 0u;

			const uint massRow0 = (mass00 & PACKED_U16_MASK) | ((mass10 & PACKED_U16_MASK) << 16);
			const uint massRow1 = (mass01 & PACKED_U16_MASK) | ((mass11 & PACKED_U16_MASK) << 16);

			writePackedMassWord(baseIndex,     massRow0);
			writePackedMassWord(baseIndex + 1, massRow1);
		}
	}

void updateChunkState()
{
	if(gl_LocalInvocationIndex != 1)
	{
		return;
	}

	const int index = chunkIndex(ivec2(gl_WorkGroupID.xy));

	int state = chunks.data[index];
	if(isUpdated())
	{
		state |= CHUNK_FLAG_SIM_ACTIVE | CHUNK_FLAG_RENDER_DIRTY;
	}
	else
	{
		state &= ~CHUNK_FLAG_SIM_ACTIVE;
	}

	chunks.data[index] = state;
}

bool isOutsideBoard(ivec2 loc)
{
	return (loc.x < 0 || loc.y < 0 || loc.x >= WIDTH || loc.y >= HEIGHT);
}

bool isInsideLocal(ivec2 localLoc)
{
	return localLoc.x >= 0
			&& localLoc.y >= 0
			&& localLoc.x < WORKGROUP_SIZE
			&& localLoc.y < WORKGROUP_SIZE;
}

uint readPackedBoard(ivec2 swizzledLoc)
{
	const int index = swizzledLoc.x * SWIZZLED_HEIGHT + swizzledLoc.y;
	return pushConstants.boardToWrite == 0 ? board2.data[index] : board1.data[index];
}

void writePackedBoard(ivec2 swizzledLoc, uint value)
{
	const int index = swizzledLoc.x * SWIZZLED_HEIGHT + swizzledLoc.y;
	if(pushConstants.boardToWrite == 0)
		board1.data[index] = value;
	else
		board2.data[index] = value;
}

void writePackedMassWord(int index, uint value)
{
	if(pushConstants.boardToWrite == 0)
		mass1.data[index] = value;
	else
		mass2.data[index] = value;
}

uint readPackedMassWord(ivec2 swizzledLoc, int row)
{
	const int index = (swizzledLoc.x * SWIZZLED_HEIGHT + swizzledLoc.y) * 2 + row;
	return pushConstants.boardToWrite == 0 ? mass2.data[index] : mass1.data[index];
}

void loadCellMaterial2x2FromGlobal(ivec2 loc, ivec2 localLoc)
{
	ivec2 swizzled = loc >> 1;
	uint value = readPackedBoard(swizzled);

	uvec4 unswizzledValue = (unswizzleVec & value) >> unswizzleOffset;

	cellMaterial[localLoc.x][localLoc.y]         = unswizzledValue.x;
	cellMaterial[localLoc.x + 1][localLoc.y]     = unswizzledValue.y;
	cellMaterial[localLoc.x][localLoc.y + 1]     = unswizzledValue.z;
	cellMaterial[localLoc.x + 1][localLoc.y + 1] = unswizzledValue.w;
}

void loadCellMass2x2FromGlobal(ivec2 loc, ivec2 localLoc)
{
	const ivec2 swizzled = loc >> 1;

	const uint row0 = readPackedMassWord(swizzled, 0);
	const uint row1 = readPackedMassWord(swizzled, 1);

	const uint mass00 = packedU16Read(row0, 0u);
	const uint mass10 = packedU16Read(row0, 16u);
	const uint mass01 = packedU16Read(row1, 0u);
	const uint mass11 = packedU16Read(row1, 16u);

	cellMass[localLoc.x][localLoc.y] = mass00;
	cellMass[localLoc.x + 1][localLoc.y] = mass10;
	cellMass[localLoc.x][localLoc.y + 1] = mass01;
	cellMass[localLoc.x + 1][localLoc.y + 1] = mass11;

	cellMassSrc[localLoc.x][localLoc.y] = mass00;
	cellMassSrc[localLoc.x + 1][localLoc.y] = mass10;
	cellMassSrc[localLoc.x][localLoc.y + 1] = mass01;
	cellMassSrc[localLoc.x + 1][localLoc.y + 1] = mass11;
}

uint readMaterialGlobal(ivec2 loc)
{
	ivec2 swizzled = loc >> 1;
	uint offset = ((loc.x & 1)	| ((loc.y & 1) << 1)) << 3;
	uint value = readPackedBoard(swizzled);

	return ((value >> offset) & 0xFFu);
}

uint readMaterial(ivec2 loc, ivec2 localLoc)
{
	if (isOutsideBoard(loc))
	{
		return 0u;
	}
	return isInsideLocal(localLoc) ? cellMaterial[localLoc.x][localLoc.y] : readMaterialGlobal(loc);
}

uint readMassGlobal(ivec2 loc)
{
	if (isOutsideBoard(loc)) return 0u;

	const ivec2 swizzled = loc >> 1;
	const int row = loc.y & 1;
	const uint shift = uint((loc.x & 1) << 4);
	const uint word = readPackedMassWord(swizzled, row);

	return packedU16Read(word, shift);
}

void markUpdated()
{
	atomicOr(updatedFlag, 1u);
}

bool isUpdated()
{
	return updatedFlag != 0u;
}

bool chooseTo(ivec2 loc, ivec2 localLoc)
{
	bool res = false;

	const uint currentValue = cellMaterial[localLoc.x][localLoc.y];
	const int density = materials[currentValue].density;
	const uint valueDown = localLoc.y < WORKGROUP_SIZE - 1 ? cellMaterial[localLoc.x][localLoc.y + 1] : readMaterialGlobal(ivec2(loc.x, loc.y + 1));

	const bool wantToFallDown = materials[valueDown].isStatic == 0
			&& density > materials[valueDown].density;
	bool luck = false;
	if (wantToFallDown)
	{
		luck = random(uvec4(loc, floatBitsToUint(pushConstants.random), 0)) < 0.92;
		if (luck)
		{
			cellDecision[localLoc.x][localLoc.y] |= uint(TO_DOWN) | (valueDown << TARGET_VALUE_POSITION);
		}
		// tag this chunk active, to prevent a no luck sleep.
		res = true;
	}

	if(!wantToFallDown || !luck)
	{
		// If not falling down, we check the right/left move
		const uint valueLeft = localLoc.x > 0 ? cellMaterial[localLoc.x - 1][localLoc.y] : readMaterialGlobal(ivec2(loc.x - 1, loc.y));
		const uint valueRight = localLoc.x < WORKGROUP_SIZE - 1 ? cellMaterial[localLoc.x + 1][localLoc.y] : readMaterialGlobal(ivec2(loc.x + 1, loc.y));
		const uint valueUp = localLoc.y > 0 ? cellMaterial[localLoc.x][localLoc.y - 1] : readMaterialGlobal(ivec2(loc.x, loc.y - 1));
		const bool isPressed = valueUp == currentValue;
		const bool pressureLiquid = isPressureLiquid(currentValue);
		const bool settledPressureLiquid = pressureLiquid && isSupportedSettledPressureLiquid(loc, localLoc, currentValue, density);

		if (pressureLiquid)
		{
			const bool canMoveLeft = materials[valueLeft].density < density && materials[valueLeft].isStatic == 0;
			const bool canMoveRight = materials[valueRight].density < density && materials[valueRight].isStatic == 0;
			const uint currentMass = cellMassSrc[localLoc.x][localLoc.y];
			uint downMass = 0u;
			if (valueDown == currentValue)
			{
				downMass = localLoc.y < WORKGROUP_SIZE - 1 ? cellMassSrc[localLoc.x][localLoc.y + 1] : readMassGlobal(loc + ivec2(0, 1));
			}
			const bool supportedBySameLiquid = valueDown == currentValue;
			const bool pushedFromBelow = settledPressureLiquid
					&& valueDown == currentValue
					&& isOverfullPressureMass(downMass, PRESSURE_SETTLED_OVERFULL_MASS);
			const bool supportedByOtherMaterial = valueDown != currentValue
					&& (materials[valueDown].isStatic == 1 || materials[valueDown].density >= density);
			const bool allowLevelFlow = supportedBySameLiquid
					|| supportedByOtherMaterial
					|| isPressed
					|| (settledPressureLiquid && isOverfullPressureMass(currentMass, PRESSURE_SETTLED_OVERFULL_MASS))
					|| pushedFromBelow;
			const bool pressureFromLeft = settledPressureLiquid && hasRearPressure(loc, localLoc, -1, currentValue, currentMass, density);
			const bool pressureFromRight = settledPressureLiquid && hasRearPressure(loc, localLoc, 1, currentValue, currentMass, density);
			const bool allowLevelFlowLeft = allowLevelFlow || pressureFromRight;
			const bool allowLevelFlowRight = allowLevelFlow || pressureFromLeft;

			const int BIG_SCORE = 0x7FFFFFFF;
			bool left = false;
			bool right = false;
			int scoreLeft = BIG_SCORE;
			int scoreRight = BIG_SCORE;

			if (canMoveLeft)
			{
				const ivec2 downLeftLoc = loc + ivec2(-1, 1);
				const ivec2 downLeftLocal = localLoc + ivec2(-1, 1);

				if (isOutsideBoard(downLeftLoc) == false)
				{
					const bool downLeftInLocal = downLeftLocal.x >= 0
							&& downLeftLocal.y >= 0
							&& downLeftLocal.x < WORKGROUP_SIZE
							&& downLeftLocal.y < WORKGROUP_SIZE;
					const uint leftDownValue = downLeftInLocal ? cellMaterial[downLeftLocal.x][downLeftLocal.y] : readMaterialGlobal(downLeftLoc);
					const bool dropLeft = materials[leftDownValue].isStatic == 0 && density > materials[leftDownValue].density;
					if (dropLeft)
					{
						left = true;
						scoreLeft = 0;
					}
					else if (allowLevelFlowLeft)
					{
						left = true;
						if (leftDownValue == currentValue)
						{
							const uint leftDownMass = downLeftInLocal ? cellMassSrc[downLeftLocal.x][downLeftLocal.y] : readMassGlobal(downLeftLoc);
							scoreLeft = 1 + int(leftDownMass);
						}
						else
						{
							scoreLeft = 1 + int(M_CAP_MAX);
						}
					}
				}
				else if (allowLevelFlowLeft)
				{
					left = true;
					scoreLeft = 1 + int(M_CAP_MAX);
				}
			}
			if (canMoveRight)
			{
				const ivec2 downRightLoc = loc + ivec2(1, 1);
				const ivec2 downRightLocal = localLoc + ivec2(1, 1);

				if (isOutsideBoard(downRightLoc) == false)
				{
					const bool downRightInLocal = downRightLocal.x >= 0
							&& downRightLocal.y >= 0
							&& downRightLocal.x < WORKGROUP_SIZE
							&& downRightLocal.y < WORKGROUP_SIZE;
					const uint rightDownValue = downRightInLocal ? cellMaterial[downRightLocal.x][downRightLocal.y] : readMaterialGlobal(downRightLoc);
					const bool dropRight = materials[rightDownValue].isStatic == 0 && density > materials[rightDownValue].density;
					if (dropRight)
					{
						right = true;
						scoreRight = 0;
					}
					else if (allowLevelFlowRight)
					{
						right = true;
						if (rightDownValue == currentValue)
						{
							const uint rightDownMass = downRightInLocal ? cellMassSrc[downRightLocal.x][downRightLocal.y] : readMassGlobal(downRightLoc);
							scoreRight = 1 + int(rightDownMass);
						}
						else
						{
							scoreRight = 1 + int(M_CAP_MAX);
						}
					}
				}
				else if (allowLevelFlowRight)
				{
					right = true;
					scoreRight = 1 + int(M_CAP_MAX);
				}
			}

			if (right || left)
			{
				uint tag = 0;
				uint targetValue = 0;
				if (right && left)
				{
					const bool bothDrop = scoreRight == 0 && scoreLeft == 0;
					if (bothDrop)
					{
						if (random(uvec4(loc, floatBitsToUint(pushConstants.random), 1)) < 0.50)
						{
							tag = TO_RIGHT;
							targetValue = valueRight;
						}
						else
						{
							tag = TO_LEFT;
							targetValue = valueLeft;
						}
					}
					else
					{
						if (left && pressureFromRight)
						{
							scoreLeft -= PRESSURE_LEVEL_SCORE_BIAS;
						}
						if (right && pressureFromLeft)
						{
							scoreRight -= PRESSURE_LEVEL_SCORE_BIAS;
						}

						const int diff = scoreRight - scoreLeft;
						if (abs(diff) > PRESSURE_LEVEL_SCORE_TIE)
						{
							if (diff < 0)
							{
								tag = TO_RIGHT;
								targetValue = valueRight;
							}
							else
							{
								tag = TO_LEFT;
								targetValue = valueLeft;
							}
						}
						else if (random(uvec4(loc, floatBitsToUint(pushConstants.random), 1)) < 0.50)
						{
							tag = TO_RIGHT;
							targetValue = valueRight;
						}
						else
						{
							tag = TO_LEFT;
							targetValue = valueLeft;
						}
					}
				}
				else if (right)
				{
					tag = TO_RIGHT;
					targetValue = valueRight;
				}
				else
				{
					tag = TO_LEFT;
					targetValue = valueLeft;
				}
				if (tag != 0)
				{
					cellDecision[localLoc.x][localLoc.y] |= tag | (targetValue << TARGET_VALUE_POSITION);
					res = true;
				}
			}
		}
		else
		{
				int runoff = materials[currentValue].runoff;
				int distLeft = runoff;
				int distRight = runoff;
				luck = pushConstants.random < 0.3;

				if (materials[valueLeft].density < density && materials[valueLeft].isStatic == 0)
				{
					if(isPressed && luck)
						distLeft = 0;
					else
					{
						distLeft = checkFree(loc, localLoc, runoff, -1, density);
						if(isPressed)
							res = true; // prevent no luck sleep
					}
				}
				if (materials[valueRight].density < density && materials[valueRight].isStatic == 0)
				{
					if(isPressed && luck)
						distRight = 0;
					else
					{
						distRight = checkFree(loc, localLoc, runoff, 1, density);
						if(isPressed)
							res = true; // prevent no luck sleep
					}
				}

				bool right = distRight < runoff;
				bool left = distLeft < runoff;
				uint targetValue = 0;

				if (right || left)
				{
					uint tag = 0;
					if (right && left)
					{
						if (distRight < distLeft)
						{
							tag = TO_RIGHT;
							targetValue = valueRight;
						}
						else if (distRight > distLeft)
						{
							tag = TO_LEFT;
							targetValue = valueLeft;
						}
						else // if (distLeft == distRight)
						{
							if (random(uvec4(loc, floatBitsToUint(pushConstants.random), 1)) < 0.50)
							{
								tag = TO_RIGHT;
								targetValue = valueRight;
							}
							else
							{
								tag = TO_LEFT;
								targetValue = valueLeft;
							}
						}
					}
					else
					{
						if (right)
						{
							tag = TO_RIGHT;
							targetValue = valueRight;
						}
						else if (left)
						{
							tag = TO_LEFT;
							targetValue = valueLeft;
						}
					}
					cellDecision[localLoc.x][localLoc.y] |= tag | (targetValue << TARGET_VALUE_POSITION);
					res = true;
				}
		}
	}

	return res;
}

bool acceptFrom(ivec2 loc, ivec2 localLoc)
{
	bool res = false;

	bool validTarget;
	uint targetValue;
	int targetDensity;
	uint invertDir;
	ivec2 targetLoc;
	ivec2 localTarget;
	uint iDir;
	float rand;

	uint value = cellMaterial[localLoc.x][localLoc.y];
	int density = materials[value].density;
	uint decisionValue = cellDecision[localLoc.x][localLoc.y];

	for (int i = 0; i < 4; i++)
	{
		switch(i)
		{
			case 0 :
				iDir = UP;
				break;
			case 1 :
				rand = random(uvec4(loc, floatBitsToUint(pushConstants.random), 2));
				iDir = rand < 0.50 ? RIGHT : LEFT;
				break;
			case 2 :
				iDir = iDir == RIGHT ? LEFT : RIGHT;
				break;
			default:
				iDir = DOWN;
				break;
		}

		// resolve the direction
		invertDir = -1u;
		switch (iDir)
		{
		case UP:
			targetLoc = ivec2(loc.x, loc.y - 1);
			localTarget = ivec2(localLoc.x, localLoc.y - 1);
			invertDir = TO_DOWN;
			break;
		case RIGHT:
			targetLoc = ivec2(loc.x + 1, loc.y);
			localTarget = ivec2(localLoc.x + 1, localLoc.y);
			invertDir = TO_LEFT;
			break;
		case LEFT:
			targetLoc = ivec2(loc.x - 1, loc.y);
			localTarget = ivec2(localLoc.x - 1, localLoc.y);
			invertDir = TO_RIGHT;
			break;
		case DOWN:
			targetLoc = ivec2(loc.x, loc.y + 1);
			localTarget = ivec2(localLoc.x, localLoc.y + 1);
			invertDir = TO_UP;
			break;
		}

		validTarget = !isOutsideBoard(targetLoc);
		targetValue =	cellMaterial[localTarget.x][localTarget.y];
		targetDensity =	materials[targetValue].density;

		if (targetDensity > density
				&& (!validTarget
						|| ((cellDecision[localTarget.x][localTarget.y]
								& invertDir) != 0)))
		{
			// Erase the target value to put the new one
			cellDecision[localLoc.x][localLoc.y] = (decisionValue & DECISION_KEEP_RANDOM_AND_INITIAL_MASK)
											| 1u << iDir
											| (targetValue << TARGET_VALUE_POSITION);

			res = true;
			i = 3; //break;
		}
	}

	return res;
}

bool swap(ivec2 loc, ivec2 localLoc)
{
	bool res = false;
	int direction;
	uint value;
	uint targetValue;
	uint invertDir;
	bool validPosition;
	ivec2 target;
	ivec2 localTarget;

	// We will take the value of our target neighbor if he does the same move.
	uint dir = decisionDirection(cellDecision[localLoc.x][localLoc.y]);

	if (dir != 0)
	{
		value = cellMaterial[localLoc.x][localLoc.y];
		// resolve the direction
		invertDir = 0;
		target = loc;
		localTarget = localLoc;
		switch (dir)
		{
		case TO_RIGHT:
			target.x += 1;
			localTarget.x += 1;
			invertDir = TO_LEFT;
			break;
		case TO_LEFT:
			target.x -= 1;
			localTarget.x -= 1;
			invertDir = TO_RIGHT;
			break;
		case TO_UP:
			target.y -= 1;
			localTarget.y -= 1;
			invertDir = TO_DOWN;
			break;
		default:
			target.y += 1;
			localTarget.y += 1;
			invertDir = TO_UP;
			break;
		}

		validPosition = !isOutsideBoard(target);
		if (!validPosition || (cellDecision[localTarget.x][localTarget.y] & invertDir) != 0)
		{
			targetValue = decisionTargetValue(cellDecision[localLoc.x][localLoc.y]);

			cellDecision[localLoc.x][localLoc.y] = (cellDecision[localLoc.x][localLoc.y] & DECISION_CLEAR_INITIAL_MASK)
					| (targetValue << INITIAL_VALUE_POSITION)
					| MOVED_TAG;

			cellMaterial[localLoc.x][localLoc.y] = targetValue;
			if (isPressureLiquid(targetValue))
			{
				const uint targetMass = validPosition ? cellMassSrc[localTarget.x][localTarget.y] : cellMassSrc[localLoc.x][localLoc.y];
				cellMass[localLoc.x][localLoc.y] = min(targetMass, M_CAP_MAX);
			}
			else
			{
				cellMass[localLoc.x][localLoc.y] = 0u;
			}
			res = true;
		}
	}
	return res;
}

#include "board_pressure_movement.glsl"

void transformPropagate(ivec2 localLoc, uint currentValue, uint targetValue, uint propagation);

bool transformation(ivec2 loc, ivec2 localLoc, bool moved)
{
	bool res = false;
	uint currentValue = decisionInitialValue(cellDecision[localLoc.x][localLoc.y]);

	// UP, DOWN, RIGHT, LEFT
	uvec4 neighborValue = uvec4(cellDecision[localLoc.x][localLoc.y - 1],
														cellDecision[localLoc.x][localLoc.y + 1],
														cellDecision[localLoc.x + 1][localLoc.y],
														cellDecision[localLoc.x - 1][localLoc.y])  >> INITIAL_VALUE_POSITION;
	bvec4 differentValue = notEqual(neighborValue, uvec4(currentValue));

	if(any(differentValue))
	{
		uvec4 transfoIndex = neighborValue * MATERIAL_COUNT + currentValue;
		uvec4 transfoIndexX = transfoIndex >> 2;
		uvec4 transfoIndexY = transfoIndex & 3u;
		uint rand = -1;
		uint transfoToApply = -1;

		for(int i = 0; i < 4; i++)
		{
			uint transfo = transformations.data[transfoIndexX[i]][transfoIndexY[i]];
			bool staticTransfo = (transfo & STATIC_TRANSFO_FLAG) != 0;
			if(transfo != -1 && (differentValue[i] || (staticTransfo && !moved)))
			{
				if(rand == -1)
				{
					float genRand = sqrt(random(uvec4(loc, floatBitsToUint(pushConstants.random), 3)));
					rand = uint(round(genRand * 1000.));
				}

				uint probability = (transfo << 2) >> 18;
				if (rand < probability)
				{
					transfoToApply = transfo;
					break;
				}
			}
		}

		if(transfoToApply != -1)
		{
			uint targetValue = transfoToApply & 255u;
			if(applyTransform(localLoc, currentValue, targetValue))
			{
				uint propagation = (transfoToApply & 65280u) >> 8;
				if(propagation > 1)
				{
					transformPropagate(localLoc, currentValue, targetValue, propagation);
				}
				res = true;
			}
		}
	}

	return res;
}

void transformPropagate(ivec2 localLoc, uint currentValue, uint targetValue, uint propagation)
{
	int offset = 1;
	bool up = true;
	bool down = true;
	bool right = true;
	bool left = true;

	while(propagation > 1)
	{
		if (up)
		{
			uint valueUp = localLoc.y - offset > 1 ? decisionInitialValue(cellDecision[localLoc.x][localLoc.y - offset]) : 0;
			if (valueUp == currentValue)
			{
				if(!applyTransform(ivec2(localLoc.x, localLoc.y - offset), currentValue, targetValue))
				{
					up = false;
				}
			}
			else
			{
				up = false;
			}
		}
		if (down)
		{
			uint valueDown = localLoc.y + offset < (HEIGHT - 2) ? decisionInitialValue(cellDecision[localLoc.x][localLoc.y + offset]) : 0;
			if (valueDown == currentValue)
			{
				if(!applyTransform(ivec2(localLoc.x, localLoc.y + offset), currentValue, targetValue))
				{
					down = false;
				}
			}
			else
			{
				down = false;
			}
		}
		if (right)
		{
			uint valueRight = localLoc.x + offset < (WIDTH - 2) ? decisionInitialValue(cellDecision[localLoc.x + offset][localLoc.y]) : 0;
			if (valueRight == currentValue)
			{
				if(!applyTransform(ivec2(localLoc.x + offset, localLoc.y), currentValue, targetValue))
				{
					right = false;
				}
			}
			else
			{
				right = false;
			}
		}
		if (left)
		{
			uint valueLeft = localLoc.x - offset > 1 ? decisionInitialValue(cellDecision[localLoc.x - offset][localLoc.y]) : 0;
			if (valueLeft == currentValue)
			{
				if(!applyTransform(ivec2(localLoc.x - offset, localLoc.y), currentValue, targetValue))
				{
					left = false;
				}
			}
			else
			{
				left = false;
			}
		}

		propagation --;
		offset ++;
	}
}

bool applyTransform(ivec2 localLoc, uint currentValue, uint targetValue)
{
	if(currentValue == targetValue)
	{
		return false;
	}

	cellMaterial[localLoc.x][localLoc.y] = targetValue;
	if (isPressureLiquid(currentValue) == false && isPressureLiquid(targetValue))
	{
		cellMass[localLoc.x][localLoc.y] = M_FULL;
	}
	else if (isPressureLiquid(currentValue) && isPressureLiquid(targetValue) == false)
	{
		cellMass[localLoc.x][localLoc.y] = 0u;
	}
	return true;
}

#include "board_pressure_queries.glsl"

int checkFree(ivec2 loc, in ivec2 localLoc, int runoff, int dir, int srcDensity)
{
	int course = 0;

	if (loc.y + 1 < HEIGHT)
	{
		if(loc.x < runoff) runoff = loc.x;
		if(WIDTH - 1 - loc.x < runoff) runoff = WIDTH - 1 - loc.x;

		while (course < runoff)
		{
			loc.x += dir;
			localLoc.x += dir;

			bool xValid = localLoc.x >= 0 && localLoc.x < WORKGROUP_SIZE;
			uint neighborValue = xValid ? cellMaterial[localLoc.x][localLoc.y] : readMaterialGlobal(loc);
			if (configuration.materials[neighborValue].isStatic == 1
					|| configuration.materials[neighborValue].density >= srcDensity)
			{
				course = runoff + 1;
				break;
			}


			uint valueDown = xValid ? cellMaterial[localLoc.x][localLoc.y + 1] : readMaterialGlobal(ivec2(loc.x, loc.y + 1));
			if ((xValid && materials[valueDown].isStatic == 0	&& materials[valueDown].density < srcDensity)
				|| (!xValid && valueDown == 0))
			{
				break;
			}

			course++;
		}
	}

	return course;
}
