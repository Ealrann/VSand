#version 450

#define WORKGROUP_SIZE_X 16
#define WORKGROUP_SIZE_Y 16

layout (local_size_x = WORKGROUP_SIZE_X, local_size_y = WORKGROUP_SIZE_Y, local_size_z = 1) in;

layout (constant_id = 0) const int MATERIAL_COUNT = 1;
layout (constant_id = 1) const int WIDTH = 1;
layout (constant_id = 2) const int HEIGHT = 1;

const int CHUNK_WIDTH = WIDTH / WORKGROUP_SIZE_X;
const int CHUNK_HEIGHT = HEIGHT / WORKGROUP_SIZE_Y;

const int SWIZZLED_WIDTH = WIDTH / 2;
const int SWIZZLED_HEIGHT = HEIGHT / 2;

#include "mass_utils.glsl"

const int CHUNK_FLAG_SIM_ACTIVE = 1;
const int CHUNK_FLAG_LIQUID_ACTIVE = 4;
const int CHUNK_SIMULATION_MASK = CHUNK_FLAG_SIM_ACTIVE | CHUNK_FLAG_LIQUID_ACTIVE;

const uint MATERIAL_FLAG_PRESSURE_LIQUID = 1u;

const uint DIR_DOWN = 0u;
const uint DIR_RIGHT = 1u;
const uint DIR_LEFT = 2u;
const uint DIR_UP = 3u;

const uint HEAD_GROUNDED_BIT = 0x80000000u;
const uint HEAD_VALUE_MASK = 0x7FFFFFFFu;

struct Entry
{
	int isStatic;
	int density;
	int runoff;
	int flags;
	vec4 color;
};

layout (push_constant) uniform PushConstants
{
	float random;
	uint boardToWrite;
} pushConstants;

layout(binding = 0) uniform SConfiguration
{
	Entry materials[MATERIAL_COUNT];
} configuration;

layout(binding = 2) buffer SChunks
{
	int data[CHUNK_WIDTH * CHUNK_HEIGHT];
} chunks;

layout(binding = 3) buffer SBoard1
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT];
} board1;

layout(binding = 4) buffer SBoard2
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT];
} board2;

layout(binding = 5) buffer SMass1
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT * 2];
} mass1;

layout(binding = 6) buffer SMass2
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT * 2];
} mass2;

layout(binding = 7) buffer readonly SHead
{
	uint data[];
} head;

shared uint cellMaterial[WORKGROUP_SIZE_X][WORKGROUP_SIZE_Y];
shared uint cellMass[WORKGROUP_SIZE_X][WORKGROUP_SIZE_Y];
shared uint updatedFlag;

uint readPackedBoard(ivec2 swizzledLoc);
uint readMaterialGlobal(ivec2 loc);
uint readPackedMassWord(int index);
uint readMassGlobal(ivec2 loc);
void writePackedBoard(ivec2 swizzledLoc, uint value);
void writePackedMassWord(int index, uint value);
bool isOutsideBoard(ivec2 loc);
bool isPressureLiquid(uint materialId);
bool shouldProcessChunk(ivec2 chunkLoc);
bool isChunkActive(ivec2 chunkLoc);
int chunkIndex(ivec2 chunkLoc);
uint stableStateEq(uint totalMass);
bool isSupported(ivec2 loc, uint materialId);
bool isSurface(ivec2 loc, uint materialId);
uint countSameLiquidNeighborsExcludingSource(ivec2 destLoc, ivec2 srcLoc, uint materialId);
bool allowLateralIntoEmpty(ivec2 srcLoc, ivec2 destLoc, uint materialId);
void markUpdated();
bool isUpdated();
void updateChunkState();
uint computeFlow(ivec2 srcLoc,
				 uint srcMat,
				 uint srcMass,
				 ivec2 dstLoc,
				 uint dstMat,
				 uint dstMass,
				 uint stepDir);

void main()
{
	const ivec2 loc = ivec2(gl_GlobalInvocationID.xy);
	if (isOutsideBoard(loc)) return;

	if (gl_LocalInvocationIndex == 0)
	{
		updatedFlag = 0u;
	}

	barrier();

	const ivec2 chunkLoc = ivec2(gl_WorkGroupID.xy);
	const bool processChunk = shouldProcessChunk(chunkLoc);

	const uint materialId = readMaterialGlobal(loc);
	const uint rawMass = readMassGlobal(loc);
	const bool pressureLiquid = materialId != 0u && isPressureLiquid(materialId);
	const uint mass = pressureLiquid ? rawMass : 0u;

	uint newMaterialId = materialId;
	uint newMass = rawMass;

	if (processChunk)
	{
		const uint stepDir = floatBitsToUint(pushConstants.random);
		ivec2 dirVec = ivec2(0);
		if (stepDir == DIR_DOWN) dirVec = ivec2(0, 1);
		else if (stepDir == DIR_RIGHT) dirVec = ivec2(1, 0);
		else if (stepDir == DIR_LEFT) dirVec = ivec2(-1, 0);
		else if (stepDir == DIR_UP) dirVec = ivec2(0, -1);

		const ivec2 dstLoc = loc + dirVec;
		const ivec2 srcLoc = loc - dirVec;

		uint outFlow = 0u;
		uint inFlow = 0u;
		uint inMaterialId = 0u;

		if (pressureLiquid && mass > 0u)
		{
			const bool dstValid = isOutsideBoard(dstLoc) == false;
			const uint dstMat = dstValid ? readMaterialGlobal(dstLoc) : 0u;
			const uint dstMass = (dstValid && dstMat == materialId) ? readMassGlobal(dstLoc) : 0u;
			outFlow = computeFlow(loc, materialId, mass, dstLoc, dstMat, dstMass, stepDir);
		}

		if (isOutsideBoard(srcLoc) == false)
		{
			const uint srcMat = readMaterialGlobal(srcLoc);
			const bool srcPressure = srcMat != 0u && isPressureLiquid(srcMat);
			const uint srcMass = srcPressure ? readMassGlobal(srcLoc) : 0u;
			const uint dstMass = (materialId == srcMat && pressureLiquid) ? mass : 0u;
			if (srcMass > 0u)
			{
				inFlow = computeFlow(srcLoc, srcMat, srcMass, loc, materialId, dstMass, stepDir);
				if (inFlow > 0u) inMaterialId = srcMat;
			}
		}

		int newMassInt = int(mass) + int(inFlow) - int(outFlow);
		newMassInt = clamp(newMassInt, 0, int(M_CAP_MAX));
		newMass = uint(newMassInt);

		if (materialId == 0u)
		{
			newMaterialId = newMass == 0u ? 0u : inMaterialId;
		}
		else if (pressureLiquid)
		{
			if (newMass == 0u)
			{
				newMaterialId = 0u;
			}
		}
		else
		{
			newMaterialId = materialId;
			newMass = 0u;
		}

		if (newMaterialId == 0u)
		{
			newMass = 0u;
		}

		const uint oldMassForUpdate = pressureLiquid ? mass : rawMass;
		if (newMaterialId != materialId
			|| inFlow > 0u
			|| outFlow > 0u
			|| abs(int(newMass) - int(oldMassForUpdate)) >= int(MIN_FLOW))
		{
			markUpdated();
		}
	}

	cellMaterial[gl_LocalInvocationID.x][gl_LocalInvocationID.y] = newMaterialId;
	cellMass[gl_LocalInvocationID.x][gl_LocalInvocationID.y] = newMass;

	barrier();

	if ((gl_LocalInvocationID.x & 1) == 0 && (gl_LocalInvocationID.y & 1) == 0)
	{
		const ivec2 swizzledLoc = loc >> 1;

		const uint value = cellMaterial[gl_LocalInvocationID.x][gl_LocalInvocationID.y]
						| (cellMaterial[gl_LocalInvocationID.x + 1][gl_LocalInvocationID.y] << 8)
						| (cellMaterial[gl_LocalInvocationID.x][gl_LocalInvocationID.y + 1] << 16)
						| (cellMaterial[gl_LocalInvocationID.x + 1][gl_LocalInvocationID.y + 1] << 24);
		writePackedBoard(swizzledLoc, value);

		const int baseIndex = (swizzledLoc.x * SWIZZLED_HEIGHT + swizzledLoc.y) * 2;
		const uint massRow0 = (cellMass[gl_LocalInvocationID.x][gl_LocalInvocationID.y]         & PACKED_U16_MASK)
							| ((cellMass[gl_LocalInvocationID.x + 1][gl_LocalInvocationID.y]     & PACKED_U16_MASK) << 16);
		const uint massRow1 = (cellMass[gl_LocalInvocationID.x][gl_LocalInvocationID.y + 1]     & PACKED_U16_MASK)
							| ((cellMass[gl_LocalInvocationID.x + 1][gl_LocalInvocationID.y + 1] & PACKED_U16_MASK) << 16);
		writePackedMassWord(baseIndex, massRow0);
		writePackedMassWord(baseIndex + 1, massRow1);
	}

	barrier();
	updateChunkState();
}

uint computeFlow(ivec2 srcLoc,
				 uint srcMat,
				 uint srcMass,
				 ivec2 dstLoc,
				 uint dstMat,
				 uint dstMass,
				 uint stepDir)
{
	if (srcMass == 0u) return 0u;
	if (isPressureLiquid(srcMat) == false) return 0u;

	const bool dstOutside = isOutsideBoard(dstLoc);
	if (stepDir == DIR_DOWN && dstOutside)
	{
		return srcMass;
	}
	else if (dstOutside)
	{
		return 0u;
	}

	const ivec2 srcChunk = srcLoc / ivec2(WORKGROUP_SIZE_X, WORKGROUP_SIZE_Y);
	const ivec2 dstChunk = dstLoc / ivec2(WORKGROUP_SIZE_X, WORKGROUP_SIZE_Y);
	if (shouldProcessChunk(srcChunk) == false || shouldProcessChunk(dstChunk) == false)
	{
		return 0u;
	}

	if (dstMat != 0u)
	{
		if (dstMat != srcMat) return 0u;
		if (isPressureLiquid(dstMat) == false) return 0u;
	}

	if (stepDir == DIR_DOWN)
	{
		const uint desiredBelow = min(stableStateEq(srcMass + dstMass), M_EQ_MAX);
		if (desiredBelow <= dstMass) return 0u;

		const uint proposed = desiredBelow - dstMass;
		const uint capacity = M_CAP_MAX - dstMass;
		uint candidate = min(proposed, min(srcMass, capacity));
		return candidate >= MIN_FLOW ? candidate : 0u;
	}

	if (stepDir == DIR_UP)
	{
		if (isSupported(srcLoc, srcMat) == false) return 0u;
		if (srcMass <= M_FULL) return 0u;
		if (dstMass >= M_FULL) return 0u;

		const uint excess = srcMass - M_FULL;
		const uint need = M_FULL - dstMass;
		uint candidate = min(excess, need);
		candidate = min(candidate, M_CAP_MAX - dstMass);
		return candidate >= MIN_FLOW ? candidate : 0u;
	}

	const int srcIndex = srcLoc.x + srcLoc.y * WIDTH;
	if ((head.data[srcIndex] & HEAD_GROUNDED_BIT) == 0u) return 0u;

	if (dstMat == 0u && allowLateralIntoEmpty(srcLoc, dstLoc, srcMat) == false)
	{
		return 0u;
	}

	const int dstIndex = dstLoc.x + dstLoc.y * WIDTH;
	const uint srcHead = head.data[srcIndex] & HEAD_VALUE_MASK;
	const uint dstHead = dstMat == srcMat ? (head.data[dstIndex] & HEAD_VALUE_MASK) : 0u;
	const int dp = int(srcHead) - int(dstHead);
	if (dp <= 0) return 0u;

	const uint proposed = uint(dp) / H_HEAD_DIV;
	uint candidate = min(proposed, min(srcMass, M_CAP_MAX - dstMass));
	if (candidate < MIN_FLOW) return 0u;

	if (candidate == srcMass && isSurface(srcLoc, srcMat) == false)
	{
		candidate = srcMass > MIN_FLOW ? srcMass - MIN_FLOW : 0u;
	}

	return candidate >= MIN_FLOW ? candidate : 0u;
}

void markUpdated()
{
	atomicOr(updatedFlag, 1u);
}

bool isUpdated()
{
	return updatedFlag != 0u;
}

void updateChunkState()
{
	if (gl_LocalInvocationIndex != 1)
	{
		return;
	}

	if (isUpdated() == false) return;
	const int index = chunkIndex(ivec2(gl_WorkGroupID.xy));
	chunks.data[index] |= 3;
}

bool isPressureLiquid(uint materialId)
{
	return (uint(configuration.materials[materialId].flags) & MATERIAL_FLAG_PRESSURE_LIQUID) != 0u;
}

int chunkIndex(ivec2 chunkLoc)
{
	return chunkLoc.x * CHUNK_HEIGHT + chunkLoc.y;
}

bool isChunkActive(ivec2 chunkLoc)
{
	return (chunks.data[chunkIndex(chunkLoc)] & CHUNK_SIMULATION_MASK) != 0;
}

bool shouldProcessChunk(ivec2 chunkLoc)
{
	if (isChunkActive(chunkLoc)) return true;

	if (chunkLoc.x > 0 && isChunkActive(chunkLoc + ivec2(-1, 0))) return true;
	if (chunkLoc.y > 0 && isChunkActive(chunkLoc + ivec2(0, -1))) return true;
	if (chunkLoc.x < CHUNK_WIDTH - 1 && isChunkActive(chunkLoc + ivec2(1, 0))) return true;
	if (chunkLoc.y < CHUNK_HEIGHT - 1 && isChunkActive(chunkLoc + ivec2(0, 1))) return true;

	if (chunkLoc.x > 1 && isChunkActive(chunkLoc + ivec2(-2, 0))) return true;
	if (chunkLoc.y > 1 && isChunkActive(chunkLoc + ivec2(0, -2))) return true;
	if (chunkLoc.x < CHUNK_WIDTH - 2 && isChunkActive(chunkLoc + ivec2(2, 0))) return true;
	if (chunkLoc.y < CHUNK_HEIGHT - 2 && isChunkActive(chunkLoc + ivec2(0, 2))) return true;

	return false;
}

uint stableStateEq(uint totalMass)
{
	const uint maxCompress = M_EQ_MAX - M_FULL;
	if (totalMass <= M_FULL) return M_FULL;
	if (totalMass < (2u * M_FULL + maxCompress))
	{
		const uint numerator = (M_FULL * M_FULL) + (totalMass * maxCompress);
		return numerator / (M_FULL + maxCompress);
	}
	return (totalMass + maxCompress) / 2u;
}

bool isSupported(ivec2 loc, uint materialId)
{
	if (loc.y + 1 >= HEIGHT) return false;

	const ivec2 belowLoc = loc + ivec2(0, 1);
	const uint belowMat = readMaterialGlobal(belowLoc);
	if (belowMat == 0u) return false;

	const int belowDensity = configuration.materials[belowMat].density;
	const int currentDensity = configuration.materials[materialId].density;
	return configuration.materials[belowMat].isStatic != 0 || belowDensity >= currentDensity;
}

bool isSurface(ivec2 loc, uint materialId)
{
	if (loc.y == 0) return true;
	return readMaterialGlobal(loc + ivec2(0, -1)) == 0u;
}

uint countSameLiquidNeighborsExcludingSource(ivec2 destLoc, ivec2 srcLoc, uint materialId)
{
	uint count = 0u;

	const ivec2 up = destLoc + ivec2(0, -1);
	if (up != srcLoc && up.y >= 0 && readMaterialGlobal(up) == materialId) count++;

	const ivec2 down = destLoc + ivec2(0, 1);
	if (down != srcLoc && down.y < HEIGHT && readMaterialGlobal(down) == materialId) count++;

	const ivec2 left = destLoc + ivec2(-1, 0);
	if (left != srcLoc && left.x >= 0 && readMaterialGlobal(left) == materialId) count++;

	const ivec2 right = destLoc + ivec2(1, 0);
	if (right != srcLoc && right.x < WIDTH && readMaterialGlobal(right) == materialId) count++;

	return count;
}

bool allowLateralIntoEmpty(ivec2 srcLoc, ivec2 destLoc, uint materialId)
{
	if (isSupported(destLoc, materialId)) return true;
	if (countSameLiquidNeighborsExcludingSource(destLoc, srcLoc, materialId) >= 1u) return true;

	if (destLoc.y + 1 >= HEIGHT) return false;
	if (readMaterialGlobal(destLoc + ivec2(0, 1)) != 0u) return false;

	return isSurface(srcLoc, materialId);
}

bool isOutsideBoard(ivec2 loc)
{
	return (loc.x < 0 || loc.y < 0 || loc.x >= WIDTH || loc.y >= HEIGHT);
}

uint readPackedBoard(ivec2 swizzledLoc)
{
	const int index = swizzledLoc.x * SWIZZLED_HEIGHT + swizzledLoc.y;
	return pushConstants.boardToWrite == 0 ? board2.data[index] : board1.data[index];
}

uint readMaterialGlobal(ivec2 loc)
{
	ivec2 swizzled = loc >> 1;
	uint offset = ((loc.x & 1) | ((loc.y & 1) << 1)) << 3;
	uint value = readPackedBoard(swizzled);
	return (value >> offset) & 0xFFu;
}

uint readPackedMassWord(int index)
{
	return pushConstants.boardToWrite == 0 ? mass2.data[index] : mass1.data[index];
}

uint readMassGlobal(ivec2 loc)
{
	const uvec2 ms = massIndexShift(loc);
	const uint word = readPackedMassWord(int(ms.x));
	return packedU16Read(word, ms.y);
}

void writePackedBoard(ivec2 swizzledLoc, uint value)
{
	const int index = swizzledLoc.x * SWIZZLED_HEIGHT + swizzledLoc.y;
	if (pushConstants.boardToWrite == 0)
		board1.data[index] = value;
	else
		board2.data[index] = value;
}

void writePackedMassWord(int index, uint value)
{
	if (pushConstants.boardToWrite == 0)
		mass1.data[index] = value;
	else
		mass2.data[index] = value;
}
