#version 450

#define WORKGROUP_SIZE_X 16
#define WORKGROUP_SIZE_Y 16

layout (local_size_x = WORKGROUP_SIZE_X, local_size_y = WORKGROUP_SIZE_Y, local_size_z = 1) in;

layout (constant_id = 0) const int MATERIAL_COUNT = 1;
layout (constant_id = 1) const int WIDTH = 1;
layout (constant_id = 2) const int HEIGHT = 1;

const int CHUNK_WIDTH = WIDTH / WORKGROUP_SIZE_X;
const int CHUNK_HEIGHT = HEIGHT / WORKGROUP_SIZE_Y;

const int SWIZZLED_WIDTH = WIDTH / 2;
const int SWIZZLED_HEIGHT = HEIGHT / 2;

#include "mass_utils.glsl"

const int CHUNK_FLAG_SIM_ACTIVE = 1;
const int CHUNK_FLAG_LIQUID_ACTIVE = 4;
const int CHUNK_SIMULATION_MASK = CHUNK_FLAG_SIM_ACTIVE | CHUNK_FLAG_LIQUID_ACTIVE;

const uint MATERIAL_FLAG_PRESSURE_LIQUID = 1u;

struct Entry
{
	int isStatic;
	int density;
	int runoff;
	int flags;
	vec4 color;
};

layout (push_constant) uniform PushConstants
{
	float random;
	uint boardToWrite;
} pushConstants;

layout(binding = 0) uniform SConfiguration
{
	Entry materials[MATERIAL_COUNT];
} configuration;

layout(binding = 2) buffer SChunks
{
	int data[CHUNK_WIDTH * CHUNK_HEIGHT];
} chunks;

layout(binding = 3) buffer readonly SBoard1
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT];
} board1;

layout(binding = 4) buffer readonly SBoard2
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT];
} board2;

layout(binding = 5) buffer readonly SMass1
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT * 2];
} mass1;

layout(binding = 6) buffer readonly SMass2
{
	uint data[SWIZZLED_WIDTH * SWIZZLED_HEIGHT * 2];
} mass2;

layout(binding = 7) buffer SFluxDown
{
	uint data[];
} fluxDown;

layout(binding = 8) buffer SFluxUp
{
	uint data[];
} fluxUp;

layout(binding = 9) buffer SFluxRight
{
	uint data[];
} fluxRight;

layout(binding = 10) buffer SFluxLeft
{
	uint data[];
} fluxLeft;

uint readPackedBoard(ivec2 swizzledLoc);
uint readMaterialGlobal(ivec2 loc);
uint readPackedMassWord(int index);
uint readMassGlobal(ivec2 loc);
int chunkIndex(ivec2 chunkLoc);
bool isChunkActive(ivec2 chunkLoc);
bool shouldProcessChunk(ivec2 chunkLoc);
bool isOutsideBoard(ivec2 loc);
bool isPressureLiquid(uint materialId);
uint stableState(uint totalMass);
uint countSameLiquidNeighborsExcludingSource(ivec2 destLoc, ivec2 srcLoc, uint materialId);
bool isSupported(ivec2 loc, uint materialId);
bool hasPressurizedNeighbor(ivec2 loc, ivec2 dir, uint materialId);
uint claimScoreForDestNeighbor(ivec2 srcLoc, ivec2 destLoc, uint dirPriority, uint dirRank);
bool isWinningSourceForDest(ivec2 srcLoc, ivec2 destLoc, uint dirPriority, uint dirRank);

void main()
{
	const ivec2 loc = ivec2(gl_GlobalInvocationID.xy);
	if (isOutsideBoard(loc)) return;

	const ivec2 chunkLoc = ivec2(gl_WorkGroupID.xy);
	if (shouldProcessChunk(chunkLoc) == false) return;

	const int linearIndex = loc.x + loc.y * WIDTH;

	const uint materialId = readMaterialGlobal(loc);
	if (materialId == 0u || isPressureLiquid(materialId) == false)
	{
		fluxDown.data[linearIndex] = 0u;
		fluxUp.data[linearIndex] = 0u;
		fluxRight.data[linearIndex] = 0u;
		fluxLeft.data[linearIndex] = 0u;
		return;
	}

	const uint mass = readMassGlobal(loc);
	if (mass == 0u)
	{
		fluxDown.data[linearIndex] = 0u;
		fluxUp.data[linearIndex] = 0u;
		fluxRight.data[linearIndex] = 0u;
		fluxLeft.data[linearIndex] = 0u;
		return;
	}

	if (isSupported(loc, materialId) == false)
	{
		fluxDown.data[linearIndex] = 0u;
		fluxUp.data[linearIndex] = 0u;
		fluxRight.data[linearIndex] = 0u;
		fluxLeft.data[linearIndex] = 0u;
		return;
	}

	uint remaining = mass;

	uint flowDown = 0u;
	uint flowUp = 0u;
	uint flowRight = 0u;
	uint flowLeft = 0u;

	const ivec2 downLoc = loc + ivec2(0, 1);
	if (downLoc.y >= HEIGHT)
	{
		flowDown = remaining;
		remaining = 0u;
	}
	else
	{
		const uint matBelow = readMaterialGlobal(downLoc);
		if (matBelow == 0u || matBelow == materialId)
		{
			const uint mb = matBelow == materialId ? readMassGlobal(downLoc) : 0u;
			const uint desiredBelow = min(stableState(remaining + mb), M_MAX);
			if (desiredBelow > mb)
			{
				const uint capacityBelow = M_MAX - mb;
				const uint proposed = desiredBelow - mb;
				const uint candidate = min(proposed, min(remaining, capacityBelow));
				if (candidate >= MIN_FLOW)
				{
					flowDown = candidate;
					remaining -= flowDown;
				}
			}
		}
	}

	const ivec2 leftLoc = loc + ivec2(-1, 0);
	if (remaining > 0u && leftLoc.x >= 0)
	{
		const uint matLeft = readMaterialGlobal(leftLoc);
		if (matLeft == materialId || matLeft == 0u)
		{
			const bool emptyDest = matLeft == 0u;
			if (emptyDest == false || countSameLiquidNeighborsExcludingSource(leftLoc, loc, materialId) >= 2u)
			{
				if (isWinningSourceForDest(loc, leftLoc, 2u, 1u))
				{
					const uint mN = matLeft == materialId ? readMassGlobal(leftLoc) : 0u;
					const uint capacity = M_MAX - mN;
					const int diff = int(remaining) - int(mN);
					if (diff > 0)
					{
						const uint proposed = uint(diff / int(PRESSURE_HORIZONTAL_DIV));
						const uint candidate = min(proposed, min(remaining, capacity));
						if (candidate >= MIN_FLOW)
						{
							flowLeft = candidate;
							remaining -= flowLeft;
						}
					}
				}
			}
		}
	}

	const ivec2 rightLoc = loc + ivec2(1, 0);
	if (remaining > 0u && rightLoc.x < WIDTH)
	{
		const uint matRight = readMaterialGlobal(rightLoc);
		if (matRight == materialId || matRight == 0u)
		{
			const bool emptyDest = matRight == 0u;
			if (emptyDest == false || countSameLiquidNeighborsExcludingSource(rightLoc, loc, materialId) >= 2u)
			{
				if (isWinningSourceForDest(loc, rightLoc, 2u, 2u))
				{
					const uint mN = matRight == materialId ? readMassGlobal(rightLoc) : 0u;
					const uint capacity = M_MAX - mN;
					const int diff = int(remaining) - int(mN);
					if (diff > 0)
					{
						const uint proposed = uint(diff / int(PRESSURE_HORIZONTAL_DIV));
						const uint candidate = min(proposed, min(remaining, capacity));
						if (candidate >= MIN_FLOW)
						{
							flowRight = candidate;
							remaining -= flowRight;
						}
					}
				}
			}
		}
	}

	if (remaining > M_FULL && loc.y > 0)
	{
		const ivec2 upLoc = loc + ivec2(0, -1);
		const uint matUp = readMaterialGlobal(upLoc);
		if (matUp == 0u || matUp == materialId)
		{
			if (isWinningSourceForDest(loc, upLoc, 1u, 0u))
			{
				const uint mUp = matUp == materialId ? readMassGlobal(upLoc) : 0u;
				const uint desiredSelf = min(stableState(remaining + mUp), M_MAX);
				if (remaining > desiredSelf)
				{
					const uint proposed = remaining - desiredSelf;
					const uint capacityUp = M_MAX - mUp;
					const uint candidate = min(proposed, capacityUp);
					if (candidate >= MIN_FLOW)
					{
						flowUp = candidate;
					}
				}
			}
		}
	}

	fluxDown.data[linearIndex] = flowDown;
	fluxUp.data[linearIndex] = flowUp;
	fluxRight.data[linearIndex] = flowRight;
	fluxLeft.data[linearIndex] = flowLeft;
}

uint stableState(uint totalMass)
{
	const uint maxCompress = M_MAX - M_FULL;
	if (totalMass <= M_FULL) return M_FULL;
	if (totalMass < (2u * M_FULL + maxCompress))
	{
		const uint numerator = (M_FULL * M_FULL) + (totalMass * maxCompress);
		return numerator / (M_FULL + maxCompress);
	}
	return (totalMass + maxCompress) / 2u;
}

uint countSameLiquidNeighborsExcludingSource(ivec2 destLoc, ivec2 srcLoc, uint materialId)
{
	uint count = 0u;

	const ivec2 up = destLoc + ivec2(0, -1);
	if (up != srcLoc && up.y >= 0 && readMaterialGlobal(up) == materialId) count++;

	const ivec2 down = destLoc + ivec2(0, 1);
	if (down != srcLoc && down.y < HEIGHT && readMaterialGlobal(down) == materialId) count++;

	const ivec2 left = destLoc + ivec2(-1, 0);
	if (left != srcLoc && left.x >= 0 && readMaterialGlobal(left) == materialId) count++;

	const ivec2 right = destLoc + ivec2(1, 0);
	if (right != srcLoc && right.x < WIDTH && readMaterialGlobal(right) == materialId) count++;

	return count;
}

bool isSupported(ivec2 loc, uint materialId)
{
	if (loc.y + 1 >= HEIGHT) return false;

	const ivec2 belowLoc = loc + ivec2(0, 1);
	const uint belowMat = readMaterialGlobal(belowLoc);
	if (belowMat == 0u) return false;

	const int belowDensity = configuration.materials[belowMat].density;
	const int currentDensity = configuration.materials[materialId].density;
	return configuration.materials[belowMat].isStatic != 0 || belowDensity >= currentDensity;
}

bool hasPressurizedNeighbor(ivec2 loc, ivec2 dir, uint materialId)
{
	const ivec2 nLoc = loc + dir;
	if (isOutsideBoard(nLoc)) return false;

	if (readMaterialGlobal(nLoc) != materialId) return false;
	return readMassGlobal(nLoc) > (M_FULL + MIN_FLOW);
}

bool isWinningSourceForDest(ivec2 srcLoc, ivec2 destLoc, uint dirPriority, uint dirRank)
{
	const uint srcScore = claimScoreForDestNeighbor(srcLoc, destLoc, dirPriority, dirRank);

	uint bestScore = 0u;

	const ivec2 fromAbove = destLoc + ivec2(0, -1);
	if (fromAbove.y >= 0)
	{
		bestScore = max(bestScore, claimScoreForDestNeighbor(fromAbove, destLoc, 3u, 3u));
	}

	const ivec2 fromLeft = destLoc + ivec2(-1, 0);
	if (fromLeft.x >= 0)
	{
		bestScore = max(bestScore, claimScoreForDestNeighbor(fromLeft, destLoc, 2u, 2u));
	}

	const ivec2 fromRight = destLoc + ivec2(1, 0);
	if (fromRight.x < WIDTH)
	{
		bestScore = max(bestScore, claimScoreForDestNeighbor(fromRight, destLoc, 2u, 1u));
	}

	const ivec2 fromBelow = destLoc + ivec2(0, 1);
	if (fromBelow.y < HEIGHT)
	{
		bestScore = max(bestScore, claimScoreForDestNeighbor(fromBelow, destLoc, 1u, 0u));
	}

	return srcScore != 0u && srcScore == bestScore;
}

uint claimScoreForDestNeighbor(ivec2 srcLoc, ivec2 destLoc, uint dirPriority, uint dirRank)
{
	if (srcLoc == destLoc) return 0u;
	if (isOutsideBoard(srcLoc)) return 0u;

	const uint srcMat = readMaterialGlobal(srcLoc);
	if (srcMat == 0u || isPressureLiquid(srcMat) == false) return 0u;
	if (isSupported(srcLoc, srcMat) == false) return 0u;

	const uint srcMass = readMassGlobal(srcLoc);
	if (srcMass == 0u) return 0u;

	const uint destMat = readMaterialGlobal(destLoc);
	if (destMat != 0u && destMat != srcMat) return 0u;
	const uint destMass = destMat == srcMat ? readMassGlobal(destLoc) : 0u;
	const uint capacity = M_MAX - destMass;

	const ivec2 d = destLoc - srcLoc;
	uint potential = 0u;

	if (d.y == 1 && d.x == 0)
	{
		const uint desiredBelow = min(stableState(srcMass + destMass), M_MAX);
		if (desiredBelow > destMass)
		{
			const uint proposed = desiredBelow - destMass;
			potential = min(proposed, min(srcMass, capacity));
		}
	}
	else if (d.y == -1 && d.x == 0)
	{
		if (srcMass > M_FULL)
		{
			const uint desiredSelf = min(stableState(srcMass + destMass), M_MAX);
			if (srcMass > desiredSelf)
			{
				const uint proposed = srcMass - desiredSelf;
				potential = min(proposed, min(srcMass, capacity));
			}
		}
	}
	else if (d.y == 0 && abs(d.x) == 1)
	{
		if (destMat == 0u && countSameLiquidNeighborsExcludingSource(destLoc, srcLoc, srcMat) < 2u) return 0u;

		const int diff = int(srcMass) - int(destMass);
		if (diff > 0)
		{
			const uint proposed = uint(diff / int(PRESSURE_HORIZONTAL_DIV));
			potential = min(proposed, min(srcMass, capacity));
		}
	}

	if (potential < MIN_FLOW) return 0u;

	return (dirPriority << 20) | (potential << 4) | dirRank;
}

bool shouldProcessChunk(ivec2 chunkLoc)
{
	if (isChunkActive(chunkLoc)) return true;

	if (chunkLoc.x > 0 && isChunkActive(chunkLoc + ivec2(-1, 0))) return true;
	if (chunkLoc.y > 0 && isChunkActive(chunkLoc + ivec2(0, -1))) return true;
	if (chunkLoc.x < CHUNK_WIDTH - 1 && isChunkActive(chunkLoc + ivec2(1, 0))) return true;
	if (chunkLoc.y < CHUNK_HEIGHT - 1 && isChunkActive(chunkLoc + ivec2(0, 1))) return true;

	return false;
}

bool isPressureLiquid(uint materialId)
{
	return (uint(configuration.materials[materialId].flags) & MATERIAL_FLAG_PRESSURE_LIQUID) != 0u;
}

int chunkIndex(ivec2 chunkLoc)
{
	return chunkLoc.x * CHUNK_HEIGHT + chunkLoc.y;
}

bool isChunkActive(ivec2 chunkLoc)
{
	return (chunks.data[chunkIndex(chunkLoc)] & CHUNK_SIMULATION_MASK) != 0;
}

bool isOutsideBoard(ivec2 loc)
{
	return (loc.x < 0 || loc.y < 0 || loc.x >= WIDTH || loc.y >= HEIGHT);
}

uint readPackedBoard(ivec2 swizzledLoc)
{
	const int index = swizzledLoc.x * SWIZZLED_HEIGHT + swizzledLoc.y;
	return pushConstants.boardToWrite == 0 ? board2.data[index] : board1.data[index];
}

uint readMaterialGlobal(ivec2 loc)
{
	ivec2 swizzled = loc >> 1;
	uint offset = ((loc.x & 1) | ((loc.y & 1) << 1)) << 3;
	uint value = readPackedBoard(swizzled);
	return (value >> offset) & 0xFFu;
}

uint readPackedMassWord(int index)
{
	return pushConstants.boardToWrite == 0 ? mass2.data[index] : mass1.data[index];
}

uint readMassGlobal(ivec2 loc)
{
	const uvec2 ms = massIndexShift(loc);
	const uint word = readPackedMassWord(int(ms.x));
	return packedU16Read(word, ms.y);
}
